generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  admins    Admin[]
}

model Admin {
  id                Int         @id @default(autoincrement())
  email             String      @unique
  password          String?     // nullable — Google OAuth users have no password
  googleId          String?     @unique // Google sub ID for OAuth lookup
  organizationId    Int?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  isVerified        Boolean     @default(false)
  verificationToken String?
  createdAt         DateTime    @default(now())
  apiKeys           ApiKey[]
  securityLogs      SecurityLog[]
  adminConfig       AdminConfig?
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id])
  keyValue  String
  isActive  Int      @default(1)
  createdAt DateTime @default(now())
}

model SecurityLog {
  id                Int      @id @default(autoincrement())
  timestamp         DateTime @default(now())
  level             String   @default("INFO")
  sourceIp          String
  portId            String?
  action            String   @default("")
  badgeText         String?
  badgeColor        String?
  userIdentity      String?
  expandable        Boolean  @default(false)
  fingerprint       String?
  detail            String?
  countryCode       String?
  country           String?
  flag              String?
  crowdsecAlertId   String?  @unique
  source            String?  @default("manual")
  ipAddressPublic   String?
  adminId           Int?
  admin             Admin?   @relation(fields: [adminId], references: [id])
  isBlocked         Boolean  @default(false)
  severity          String?
  createdAt         DateTime @default(now())

  // v2.0 Scoring fields
  score             Int      @default(0)   // Skor individual event (0-16, from highest WAF rule level)
  accumulatedScore  Int      @default(0)   // Total skor akumulasi IP saat event ini diterima
  matchedRules      String?               // JSON array: ["SQL Injection","XSS"]
  decision          String?               // Keputusan: LOG | ALERT | BLOCK
}

/// Konfigurasi per-admin: threshold scoring, Telegram alert settings
model AdminConfig {
  id                 Int     @id @default(autoincrement())
  adminId            Int     @unique
  admin              Admin   @relation(fields: [adminId], references: [id])

  // Scoring thresholds (Wazuh-style)
  blockThreshold     Int     @default(10)   // Skor akumulasi untuk blokir IP
  alertThreshold     Int     @default(7)    // Skor akumulasi untuk kirim alert
  scoreWindowMinutes Int     @default(5)    // Jendela waktu akumulasi (menit)

  // Telegram alert integration
  telegramBotToken   String?
  telegramChatId     String?
  telegramEnabled    Boolean @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

